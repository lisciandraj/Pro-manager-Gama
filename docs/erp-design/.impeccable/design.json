    {
      "name": "Action principale",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action normale bleue ; les créations utilisent la variante verte.",
      "html": "<button class=\"ds-primary\" type=\"button\">Enregistrer</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E2E6E9);border-radius:var(--arc-r-sm,6px);box-shadow:var(--coco-action-shadow);cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-action-top,#2176B8) var(--coco-action-fill,none);border-color:var(--coco-action,#2176B8);color:var(--coco-on-action,#fff)}.ds-primary:hover:not(:disabled){background:var(--coco-action-hover,#1B659E)}.ds-primary:focus-visible{outline:2px solid var(--arc-accent-600,#2176B8);outline-offset:3px;}.ds-primary:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-primary:disabled{opacity:.55;cursor:not-allowed}.ds-primary{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
    },
