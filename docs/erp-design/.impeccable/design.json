      "html": "<details class=\"ds-history\"><summary class=\"ds-history-summary\">Historique du module</summary><div class=\"ds-history-body\">Aucune action enregistrée.</div></details>",
      "css": ".ds-history{border:0;border-radius:var(--arc-r-lg,8px);background:var(--coco-surface,#fff);box-shadow:none;color:var(--coco-ink,#151515);font:400 13px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-history-summary{box-sizing:border-box;min-height:44px;padding:10px 12px;font-weight:500;cursor:pointer}.ds-history-summary:hover{background:var(--coco-inset,#F9F8F8)}.ds-history-summary:focus-visible{outline:2px solid var(--arc-accent-600,#B93B00);outline-offset:3px;}.ds-history-summary:active{background:var(--arc-accent-50,#FDF7F2)}.ds-history[open]>.ds-history-summary{border-bottom:1px solid var(--coco-line,#F1F0EF)}.ds-history-body{padding:12px;color:var(--coco-muted,#6B6A69)}"
