      "html": "<button class=\"ds-ghost\" type=\"button\">Actualiser</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E2E6E9);border-radius:var(--arc-r-sm,6px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:transparent;border-color:transparent;color:var(--arc-accent-600,#2F6F42)}.ds-ghost:hover:not(:disabled){background:var(--arc-surface-3,#EEF0F2);color:var(--coco-ink,#263238)}.ds-ghost:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px;}.ds-ghost:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-ghost:disabled{opacity:.55;cursor:not-allowed}.ds-ghost{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}.ds-ghost:active{transform:none}}"
    },
    {
      "name": "Champ de saisie",
