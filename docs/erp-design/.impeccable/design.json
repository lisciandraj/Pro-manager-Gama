      "html": "<nav class=\"ds-side\" aria-label=\"Exemple de modules\"><a class=\"ds-side-link\" href=\"#dashboard\" aria-current=\"page\">Dashboard</a><a class=\"ds-side-link\" href=\"#documents\">Documents</a></nav>",
      "css": ".ds-side{width:256px;padding:16px;background:#F6F6F9;border-radius:0}.ds-side-link{display:flex;align-items:center;box-sizing:border-box;min-height:44px;padding:10px 12px;margin-bottom:4px;border-radius:8px;color:var(--coco-ink,#262331);font:400 13px/1.5 var(--arc-font,Inter,Arial,sans-serif);text-decoration:none}.ds-side-link[aria-current=page]{background:var(--arc-accent-600,#6246CC);color:#fff}.ds-side-link:hover,.ds-side-link:active{background:var(--coco-inset,#FAFAFC)}.ds-side-link:focus-visible{outline:2px solid var(--arc-accent-600,#6246CC);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Coco / GAMA — gestion sereine",
    "overview": "Coco ERP applique la référence claire et violette fournie le 7 novembre 2026 à son application réelle GitHub Pages. Navigation gris très clair, destination active violette, bandeau blanc, cartes à contour fin et tableaux aérés partagent les tokens canoniques. Inter sert aux titres, valeurs et contrôles. Le breakpoint du tiroir reste à 1180 px, avec sidebar de 256 px sur PC. Les parcours, droits, calculs, données et préférences restent conservés. Le site public possède son propre DESIGN.md à la racine ; l’aperçu Sites reste distinct.",
    "keyCharacteristics": [
      "Surfaces blanches, sidebar gris clair et accent violet.",
      "Inter locale pour les titres, valeurs et contrôles.",
      "Cartes de rayon 16 px, bordure fine et aucune ombre.",
      "Lignes de travail séparées de 8 px, statuts explicites.",
      "Tiroir accessible sous 1180 px, contrôles métier préservés."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Réserver le violet plein à la commande principale et à la destination courante.",
        "section": "colors"
      },
      {
        "name": "The Readability Rule",
        "body": "Conserver les libellés complets, les traductions et le retour à la ligne sans comprimer la cible de commande.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Cartes à contour fin sans ombre ni gradient ; profondeur réservée aux superpositions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reprendre les tokens et composants communs avant d’ajouter une règle locale.",
      "Do distinguer l’espace d’un formulaire de la densité d’une liste opérationnelle.",
      "Do conserver les pictogrammes Coco, les favoris et une action principale identifiable.",
      "Do laisser accessibles les colonnes, détails et formulaires complets à la demande.",
      "Do respecter les préférences existantes, les langues, les droits et les états réels.",
      "Do vérifier ensemble PC, téléphone, clavier et traductions longues."
    ],
    "donts": [
      "Don't remettre une seconde occurrence du titre de module dans le contenu.",
      "Don't déplacer ni cloner les contrôles métier pour composer une barre utilitaire.",
      "Don't empiler les ombres ni ajouter des halos ou textures décoratifs.",
      "Don't réintroduire des couleurs d’action locales ou des gradients sur les cartes.",
      "Don't forcer les lignes éditables ou les fenêtres en fiches sans préserver leurs contrôles.",
      "Don't transformer une valeur inconnue ou un échec de chargement en zéro ou succès.",
      "Don't appliquer ce contrat au site public ni modifier son autorité visuelle racine."
    ]
  }
