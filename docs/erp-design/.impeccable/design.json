      "html": "<label class=\"ds-field\">Référence<input class=\"ds-field-input\" type=\"text\" value=\"REF-001\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:var(--coco-field-gap,8px);color:var(--coco-ink,#263238);font:500 13px/1.5 var(--arc-font,Inter,Arial,sans-serif);}.ds-field-input{min-width:0;box-sizing:border-box;min-height:44px;padding:10px 12px;border:1px solid var(--arc-line-strong,#8A9499);border-radius:var(--arc-r-sm,6px);background:var(--coco-surface,#fff);color:var(--coco-ink,#263238);font:400 14px/1.5 var(--arc-font,Inter,Arial,sans-serif);box-shadow:none}.ds-field-input:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px;}.ds-field-input[aria-invalid=true]{border-color:var(--arc-danger,#BE3848);background:var(--arc-danger-bg,#FFF0F1)}.ds-field-input[readonly]{background:var(--coco-inset,#F7F8F9)}@media(max-width:760px){.ds-field-input{font-size:16px}}"
    },
    {
      "name": "Onglets de module",
      "kind": "nav",
      "refersTo": "module-tab",
      "description": "Onglets natifs dans le contenu, défilants, avec sélection gris clair et texte charbon.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Exemple de sections\"><button class=\"ds-tab\" aria-current=\"page\">Vue d’ensemble</button><button class=\"ds-tab\">Historique</button></nav>",
      "css": ".ds-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 0}.ds-tab{flex:none;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--coco-ink,#263238);font:400 13px/1.4 var(--arc-font,Inter,Arial,sans-serif);cursor:pointer}.ds-tab[aria-current=page]{background:var(--coco-selected,#EEF0F2);border-color:var(--coco-line,#E2E6E9);color:var(--coco-ink,#263238);font-weight:500}.ds-tab:hover{background:var(--coco-selected,#EEF0F2)}.ds-tab:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:-3px}.ds-tab:active{background:var(--coco-selected,#EEF0F2)}"
    },
