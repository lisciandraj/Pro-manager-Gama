      "description": "Onglets natifs dans le contenu du module, défilants, avec sélection violette.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Exemple de sections\"><button class=\"ds-tab\" aria-current=\"page\">Vue d’ensemble</button><button class=\"ds-tab\">Historique</button></nav>",
      "css": ".ds-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 0}.ds-tab{flex:none;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:var(--arc-r-sm,8px);background:transparent;color:var(--coco-ink,#262331);font:400 13px/1.4 var(--arc-font,Inter,Arial,sans-serif);cursor:pointer}.ds-tab[aria-current=page]{background:var(--arc-accent-100,#F0EBFC);border-color:var(--arc-accent-600,#6246CC);color:var(--arc-accent-700,#5438BA);font-weight:500}.ds-tab:hover{background:var(--arc-accent-100,#F0EBFC)}.ds-tab:focus-visible{outline:2px solid var(--arc-accent-600,#6246CC);outline-offset:-3px}.ds-tab:active{background:var(--arc-accent-100,#F0EBFC)}"
    },
    {
      "name": "Statut confirmé",
      "kind": "chip",
      "refersTo": "status-success",
      "description": "Indication lisible ; le texte explicite porte le sens du statut.",
      "html": "<span class=\"ds-status\">Confirmé</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:4px;padding:4px 9px;border:0;border-radius:6px;background:var(--arc-success-bg,#E8F8F2);color:var(--arc-success,#16785D);font:500 12px/1.55 var(--arc-font,Inter,Arial,sans-serif)}"
    },
    {
      "name": "Panneau de travail",
      "kind": "card",
      "refersTo": "panel",
      "description": "Surface blanche opaque, contour fin, rayon 16 px et aucune ombre.",
      "html": "<article class=\"ds-panel\"><h3 class=\"ds-panel-title\">Détails</h3><p class=\"ds-panel-text\">Les informations complémentaires restent accessibles dans le dossier.</p></article>",
      "css": ".ds-panel{padding:24px;border:1px solid var(--coco-line,#E9E9F0);border-radius:var(--arc-r-lg,16px);background:var(--coco-surface,#fff);color:var(--coco-ink,#262331);box-shadow:none;font:400 14px/1.55 var(--arc-font,Inter,Arial,sans-serif)}.ds-panel-title{margin:0 0 12px;font-family:var(--arc-font-display,Inter,Arial,sans-serif);font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.02em}.ds-panel-text{margin:0;color:var(--coco-muted,#676473)}@media(max-width:760px){.ds-panel{padding:16px;border-radius:16px}}"
    },
    {
      "name": "Fiche mobile de liste",
      "kind": "custom",
      "refersTo": "mobile-card",
      "description": "Fiche de consultation à valeurs de 16 px et libellés de colonne visibles.",
      "html": "<article class=\"ds-record\"><h3 class=\"ds-record-title\">Référence</h3><dl class=\"ds-record-fields\"><div><dt>Client</dt><dd>Nom du client</dd></div><div><dt>Statut</dt><dd>À traiter</dd></div></dl><button class=\"ds-record-action\" type=\"button\">Ouvrir</button></article>",
      "css": ".ds-record{padding:16px;border:0;border-radius:16px;background:var(--coco-surface,#fff);box-shadow:none;color:var(--coco-ink,#262331);font:400 16px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-record-title{margin:0 0 12px;font-size:16px;line-height:1.5;font-weight:600}.ds-record-fields{margin:0}.ds-record-fields>div{display:grid;grid-template-columns:108px minmax(0,1fr);gap:10px;padding:6px 0}.ds-record-fields dt{font-size:11px;color:var(--coco-muted,#676473)}.ds-record-fields dd{margin:0;overflow-wrap:anywhere}.ds-record-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E9E9F0);border-radius:var(--arc-r-sm,8px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);margin-top:8px;background:var(--coco-surface,#fff);color:var(--coco-ink,#262331)}.ds-record-action:hover{background:var(--coco-inset,#FAFAFC);border-color:var(--arc-accent-600,#6246CC)}.ds-record-action:focus-visible{outline:2px solid var(--arc-accent-600,#6246CC);outline-offset:3px;}.ds-record-action:active{background:var(--arc-accent-50,#F8F6FE)}"
    },
