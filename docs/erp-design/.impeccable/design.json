      "css": ".ds-create{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E2E6E9);border-radius:var(--arc-r-sm,6px);box-shadow:var(--coco-action-shadow);cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-create,#2F6F42) var(--coco-action-fill,none);border-color:var(--coco-create,#2F6F42);color:var(--coco-on-action,#fff)}.ds-create:hover:not(:disabled){background:var(--coco-create-hover,#265A36)}.ds-create:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px;}.ds-create:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-create:disabled{opacity:.55;cursor:not-allowed}.ds-create{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-create{transition:none}.ds-create:active{transform:none}}"
    },
