      "html": "<article class=\"ds-record\"><h3 class=\"ds-record-title\">Référence</h3><dl class=\"ds-record-fields\"><div><dt>Client</dt><dd>Nom du client</dd></div><div><dt>Statut</dt><dd>À traiter</dd></div></dl><button class=\"ds-record-action\" type=\"button\">Ouvrir</button></article>",
      "css": ".ds-record{padding:16px;border:0;border-radius:14px;background:var(--coco-surface,#fff);box-shadow:var(--coco-surface-shadow);color:var(--coco-ink,#29283D);font:400 16px/1.5 var(--arc-font,Poppins,Inter,Arial,sans-serif)}.ds-record-title{margin:0 0 12px;font-size:16px;line-height:1.5;font-weight:600}.ds-record-fields{margin:0}.ds-record-fields>div{display:grid;grid-template-columns:108px minmax(0,1fr);gap:10px;padding:6px 0}.ds-record-fields dt{font-size:11px;color:var(--coco-muted,#686779)}.ds-record-fields dd{margin:0;overflow-wrap:anywhere}.ds-record-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E9E7F0);border-radius:var(--arc-r-sm,12px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Poppins,Inter,Arial,sans-serif);margin-top:8px;background:var(--coco-surface,#fff);color:var(--coco-ink,#29283D)}.ds-record-action:hover{background:var(--coco-inset,#F0EFF5);border-color:var(--arc-accent-600,#10677d)}.ds-record-action:focus-visible{outline:2px solid var(--arc-accent-600,#10677d);outline-offset:3px;}.ds-record-action:active{background:var(--arc-accent-50,#f3f9fa)}"
