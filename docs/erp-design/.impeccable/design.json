      "css": ".ds-field{display:flex;flex-direction:column;gap:var(--coco-field-gap,8px);color:var(--coco-ink,#263238);font:500 13px/1.5 var(--arc-font,Inter,Arial,sans-serif);}.ds-field-input{min-width:0;box-sizing:border-box;min-height:44px;padding:10px 12px;border:1px solid var(--arc-line-strong,#8A9499);border-radius:var(--arc-r-sm,6px);background:var(--coco-surface,#fff);color:var(--coco-ink,#263238);font:400 14px/1.5 var(--arc-font,Inter,Arial,sans-serif);box-shadow:none}.ds-field-input:focus-visible{outline:2px solid var(--arc-accent-600,#2176B8);outline-offset:3px;}.ds-field-input[aria-invalid=true]{border-color:var(--arc-danger,#AB3555);background:var(--arc-danger-bg,#FCEEF3)}.ds-field-input[readonly]{background:var(--coco-inset,#F7F8F9)}@media(max-width:760px){.ds-field-input{font-size:16px}}"
