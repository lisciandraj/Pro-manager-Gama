      "css": ".ds-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 0}.ds-tab{flex:none;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--coco-ink,#263238);font:400 13px/1.4 var(--arc-font,Inter,Arial,sans-serif);cursor:pointer}.ds-tab[aria-current=page]{background:var(--coco-selected,#EAF3FB);border-color:var(--coco-line,#E2E6E9);color:var(--coco-blue-hover,#1B659E);font-weight:500}.ds-tab:hover{background:var(--coco-selected,#EAF3FB)}.ds-tab:focus-visible{outline:2px solid var(--arc-accent-600,#2176B8);outline-offset:-3px}.ds-tab:active{background:var(--coco-selected,#EAF3FB)}"
