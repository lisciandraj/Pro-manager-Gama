  "components": [
    {
      "name": "Action principale",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action orange et texte sombre ; même rôle de couleur pour les créations.",
      "html": "<button class=\"ds-primary\" type=\"button\">Enregistrer</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#F1F0EF);border-radius:var(--arc-r-sm,6px);box-shadow:var(--coco-action-shadow);cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-action-top,#EE5400) var(--coco-action-fill,none);border-color:var(--coco-action,#EE5400);color:var(--coco-on-action,#151515)}.ds-primary:hover:not(:disabled){background:var(--coco-action-hover,#E54E00)}.ds-primary:focus-visible{outline:2px solid var(--arc-accent-600,#B93B00);outline-offset:3px;}.ds-primary:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-primary:disabled{opacity:.55;cursor:not-allowed}.ds-primary{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
    },
    {
      "name": "Création",
      "kind": "button",
      "refersTo": "button-create",
      "description": "Création d’un enregistrement : fond orange et libellé sombre lisible.",
      "html": "<button class=\"ds-create\" type=\"button\">Nouveau dossier</button>",
      "css": ".ds-create{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#F1F0EF);border-radius:var(--arc-r-sm,6px);box-shadow:var(--coco-action-shadow);cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-create,#EE5400) var(--coco-action-fill,none);border-color:var(--coco-create,#EE5400);color:var(--coco-on-action,#151515)}.ds-create:hover:not(:disabled){background:var(--coco-create-hover,#E54E00)}.ds-create:focus-visible{outline:2px solid var(--arc-accent-600,#B93B00);outline-offset:3px;}.ds-create:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-create:disabled{opacity:.55;cursor:not-allowed}.ds-create{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-create{transition:none}.ds-create:active{transform:none}}"
    },
    {
      "name": "Action secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Retour ou action complémentaire sur fond blanc.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Retour</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#F1F0EF);border-radius:var(--arc-r-sm,6px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-surface,#fff);color:var(--coco-ink,#151515)}.ds-secondary:hover:not(:disabled){background:var(--coco-inset,#F9F8F8);border-color:var(--arc-accent-600,#B93B00)}.ds-secondary:focus-visible{outline:2px solid var(--arc-accent-600,#B93B00);outline-offset:3px;}.ds-secondary:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}.ds-secondary{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:active{transform:none}}"
    },
    {
      "name": "Action discrète",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Commande de moindre priorité avec libellé orange foncé.",
      "html": "<button class=\"ds-ghost\" type=\"button\">Actualiser</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#F1F0EF);border-radius:var(--arc-r-sm,6px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:transparent;border-color:transparent;color:var(--arc-accent-600,#B93B00)}.ds-ghost:hover:not(:disabled){background:var(--arc-surface-3,#F5F5F4);color:var(--coco-ink,#151515)}.ds-ghost:focus-visible{outline:2px solid var(--arc-accent-600,#B93B00);outline-offset:3px;}.ds-ghost:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-ghost:disabled{opacity:.55;cursor:not-allowed}.ds-ghost{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}.ds-ghost:active{transform:none}}"
