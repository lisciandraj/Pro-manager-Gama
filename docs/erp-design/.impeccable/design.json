      "css": ".ds-status{display:inline-flex;align-items:center;gap:4px;padding:4px 9px;border:0;border-radius:6px;background:var(--arc-success-bg,#E8F8F2);color:var(--arc-success,#16785D);font:500 12px/1.55 var(--arc-font,Inter,Arial,sans-serif)}"
    },
    {
      "name": "Panneau de travail",
      "kind": "card",
      "refersTo": "panel",
      "description": "Panneau blanc sans ombre : padding20/rayon8 px sur PC, padding16/rayon12 px sur téléphone.",
      "html": "<article class=\"ds-panel\"><h3 class=\"ds-panel-title\">Détails</h3><p class=\"ds-panel-text\">Les informations complémentaires restent accessibles dans le dossier.</p></article>",
      "css": ".ds-panel{padding:20px;border:1px solid var(--coco-line,#E2E6E9);border-radius:var(--arc-r-lg,8px);background:var(--coco-surface,#fff);color:var(--coco-ink,#263238);box-shadow:none;font:400 14px/1.55 var(--arc-font,Inter,Arial,sans-serif)}.ds-panel-title{margin:0 0 12px;font-family:var(--arc-font-display,Inter,Arial,sans-serif);font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.02em}.ds-panel-text{margin:0;color:var(--coco-muted,#5F6B72)}@media(max-width:760px){.ds-panel{padding:16px;border-radius:12px}}"
    },
    {
      "name": "Fiche mobile de liste",
      "kind": "custom",
      "refersTo": "mobile-card",
      "description": "Fiche de consultation à valeurs de 16 px et libellés de colonne visibles.",
      "html": "<article class=\"ds-record\"><h3 class=\"ds-record-title\">Référence</h3><dl class=\"ds-record-fields\"><div><dt>Client</dt><dd>Nom du client</dd></div><div><dt>Statut</dt><dd>À traiter</dd></div></dl><button class=\"ds-record-action\" type=\"button\">Ouvrir</button></article>",
      "css": ".ds-record{padding:16px;border:0;border-radius:12px;background:var(--coco-surface,#fff);box-shadow:none;color:var(--coco-ink,#263238);font:400 16px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-record-title{margin:0 0 12px;font-size:16px;line-height:1.5;font-weight:600}.ds-record-fields{margin:0}.ds-record-fields>div{display:grid;grid-template-columns:108px minmax(0,1fr);gap:10px;padding:6px 0}.ds-record-fields dt{font-size:11px;color:var(--coco-muted,#5F6B72)}.ds-record-fields dd{margin:0;overflow-wrap:anywhere}.ds-record-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E2E6E9);border-radius:var(--arc-r-sm,6px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);margin-top:8px;background:var(--coco-surface,#fff);color:var(--coco-ink,#263238)}.ds-record-action:hover{background:var(--coco-inset,#F7F8F9);border-color:var(--arc-accent-600,#2F6F42)}.ds-record-action:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px;}.ds-record-action:active{background:var(--arc-accent-50,#F4F5F7)}"
    },
    {
      "name": "Historique replié",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Résumé compact dans le flux ; partage la ligne Outils aux largeurs prévues, sans cloner les contrôles.",
      "html": "<details class=\"ds-history\"><summary class=\"ds-history-summary\">Historique du module</summary><div class=\"ds-history-body\">Aucune action enregistrée.</div></details>",
      "css": ".ds-history{border:0;border-radius:var(--arc-r-lg,8px);background:var(--coco-surface,#fff);box-shadow:none;color:var(--coco-ink,#263238);font:400 13px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-history-summary{box-sizing:border-box;min-height:44px;padding:10px 12px;font-weight:500;cursor:pointer}.ds-history-summary:hover{background:var(--coco-inset,#F7F8F9)}.ds-history-summary:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px;}.ds-history-summary:active{background:var(--arc-accent-50,#F4F5F7)}.ds-history[open]>.ds-history-summary{border-bottom:1px solid var(--coco-line,#E2E6E9)}.ds-history-body{padding:12px;color:var(--coco-muted,#5F6B72)}"
    },
    {
      "name": "Lien latéral",
      "kind": "nav",
      "refersTo": "sidebar-link",
      "description": "Navigation blanche et destination active gris clair avec texte charbon ; sidebar PC 256 px.",
      "html": "<nav class=\"ds-side\" aria-label=\"Exemple de modules\"><a class=\"ds-side-link\" href=\"#dashboard\" aria-current=\"page\">Dashboard</a><a class=\"ds-side-link\" href=\"#documents\">Documents</a></nav>",
      "css": ".ds-side{width:256px;padding:16px;background:#FFFFFF;border-radius:0}.ds-side-link{display:flex;align-items:center;box-sizing:border-box;min-height:44px;padding:10px 12px;margin-bottom:4px;border-radius:8px;color:var(--coco-ink,#263238);font:400 13px/1.5 var(--arc-font,Inter,Arial,sans-serif);text-decoration:none}.ds-side-link[aria-current=page]{background:var(--coco-selected,#EEF0F2);color:var(--coco-ink,#263238)}.ds-side-link:hover,.ds-side-link:active{background:var(--coco-inset,#F7F8F9)}.ds-side-link:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px}"
    },
    {
      "name": "Phase Kanban",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Panneau blanc à bande de phase pastel, texte charbon ; données de démonstration descriptives uniquement.",
      "html": "<section class=\"ds-phase\"><h3>Étape du dossier</h3><article>Dossier sélectionné</article></section>",
      "css": ".ds-phase{width:240px;overflow:hidden;border:1px solid var(--coco-line,#E2E6E9);border-radius:8px;background:white;color:var(--coco-ink,#263238);font:400 14px/1.55 var(--arc-font,Inter,Arial,sans-serif)}.ds-phase h3{margin:0;padding:12px 16px;background:var(--coco-phase-blue,#A9BFF1);font-size:14px;font-weight:600}.ds-phase article{margin:12px;padding:12px;border:1px solid var(--coco-line,#E2E6E9);border-radius:6px;background:white}"
    },
    {
      "name": "Tableau opérationnel",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Grille jointive de 1 px, cellules de 13 px avec marges de 10/14 px, lignes nominales de 52 px et en-têtes de 42 px ; la hauteur grandit selon le contenu.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Référence</th><th>Statut</th></tr></thead><tbody><tr><td>Dossier sélectionné</td><td>À traiter</td></tr></tbody></table>",
      "css": ".ds-table{width:100%;border-collapse:collapse;border-spacing:0;background:white;color:var(--coco-ink,#263238);font:400 13px/1.55 var(--arc-font,Inter,Arial,sans-serif)}.ds-table th,.ds-table td{border:1px solid var(--coco-line,#E2E6E9);padding:10px 14px;text-align:left;height:52px}.ds-table th{height:42px;background:white;font-size:12px;font-weight:500}.ds-table tbody tr:hover{background:var(--coco-inset,#F7F8F9)}"
    }
  ],
  "narrative": {
    "northStar": "Coco — un bureau de gestion clair",
    "overview": "Coco ERP privilégie un travail quotidien calme et lisible : choisir un module, repérer ou rechercher une information, puis agir dans les parcours existants. Une toile gris clair, une navigation blanche, des actions charbon et une création verte rendent les données utiles visibles plus tôt. La hiérarchie reprend la sobriété et la densité des références Nozti CRM fournies, en conservant l’identité Coco et les vrais contenus métier. Les formulaires séparent clairement libellés, valeurs et groupes de champs sans élargir les listes opérationnelles.",
    "keyCharacteristics": [
      "Toile gris clair, navigation blanche et panneaux blancs à contour fin sans ombre.",
      "Inter pour les titres, les valeurs et les contrôles.",
      "Libellés proches de leur champ et groupes de formulaire espacés.",
      "Actions charbon, créations vertes et destination active sur gris clair.",
      "Tableaux jointifs à grille fine, Kanban blanc à bandeaux pastel et structures métier conservées."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Distinguer l’action normale charbon de la création verte ; garder la destination courante sur une surface grise avec texte charbon.",
        "section": "colors"
      },
      {
        "name": "The Readability Rule",
        "body": "Conserver les libellés complets, les traductions et le retour à la ligne sans comprimer la cible de commande.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Cartes à contour fin sans ombre ni gradient ; profondeur réservée aux superpositions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reprendre les tokens et composants communs avant d’ajouter une règle locale.",
      "Do distinguer l’espace d’un formulaire de la densité d’une liste opérationnelle.",
      "Do conserver les pictogrammes Coco, les favoris et une action principale identifiable.",
      "Do laisser accessibles les colonnes, détails et formulaires complets à la demande.",
      "Do respecter les préférences existantes, les langues, les droits et les états réels.",
      "Do vérifier ensemble PC, téléphone, zoom 200 %, clavier et traductions longues."
    ],
    "donts": [
      "Don't remettre une seconde occurrence du titre de module dans le contenu.",
      "Don't déplacer ni cloner les contrôles métier pour composer une barre utilitaire.",
      "Don't empiler les ombres ni ajouter des halos ou textures décoratifs.",
      "Don't réintroduire des couleurs d’action locales ou des gradients sur les cartes.",
      "Don't forcer les lignes éditables ou les fenêtres en fiches sans préserver leurs contrôles.",
      "Don't transformer une valeur inconnue ou un échec de chargement en zéro ou succès.",
      "Don't copier les données, textes, marques ou logos de Nozti CRM.",
      "Don't appliquer ce contrat au site public ni modifier son autorité visuelle racine."
    ]
  }
}
