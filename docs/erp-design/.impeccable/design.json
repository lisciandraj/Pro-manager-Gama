      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E2E6E9);border-radius:var(--arc-r-sm,6px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-surface,#fff);color:var(--coco-ink,#263238)}.ds-secondary:hover:not(:disabled){background:var(--coco-inset,#F7F8F9);border-color:var(--arc-accent-600,#2F6F42)}.ds-secondary:focus-visible{outline:2px solid var(--arc-accent-600,#2F6F42);outline-offset:3px;}.ds-secondary:active:not(:disabled,[aria-busy=true]){transform:none;box-shadow:none}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}.ds-secondary{transition:background-color var(--coco-motion-feedback,120ms),border-color var(--coco-motion-feedback,120ms),box-shadow var(--coco-motion-feedback,120ms),transform var(--coco-motion-feedback,120ms) var(--coco-ease,cubic-bezier(.16,1,.3,1))}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:active{transform:none}}"
    },
    {
      "name": "Action discrète",
      "kind": "button",
      "refersTo": "button-ghost",
