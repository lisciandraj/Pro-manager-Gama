      "html": "<button class=\"ds-primary\" type=\"button\">Enregistrer</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#dfe6eb);border-radius:var(--arc-r-sm,10px);box-shadow:var(--coco-action-shadow);cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);background:var(--coco-action-fill,linear-gradient(#BD4E09,#B54708));border-color:var(--coco-action,#bd4e09);color:var(--coco-on-action,#fff)}.ds-primary:hover:not(:disabled){background:var(--coco-action-hover,#b54708)}.ds-primary:focus-visible{outline:2px solid var(--arc-accent-600,#10677d);outline-offset:3px;}.ds-primary:active:not(:disabled){background:var(--coco-action-hover,#b54708)}.ds-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
