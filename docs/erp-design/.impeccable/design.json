      "css": ".ds-panel{padding:24px;border:0;border-radius:var(--arc-r-lg,22px);background:var(--coco-surface,#fff);color:var(--coco-ink,#29283D);box-shadow:var(--coco-surface-shadow);font:400 14px/1.55 var(--arc-font,Poppins,Inter,Arial,sans-serif)}.ds-panel-title{margin:0 0 12px;font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.02em}.ds-panel-text{margin:0;color:var(--coco-muted,#686779)}@media(max-width:760px){.ds-panel{padding:16px}}"
