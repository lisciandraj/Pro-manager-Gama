      "html": "<label class=\"ds-field\">Référence<input class=\"ds-field-input\" type=\"text\" value=\"REF-001\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:var(--coco-field-gap,8px);color:var(--coco-ink,#283B42);font:500 13px/1.5 var(--arc-font,Inter,Arial,sans-serif);}.ds-field-input{min-width:0;box-sizing:border-box;min-height:44px;padding:10px 12px;border:1px solid var(--arc-line-strong,#819298);border-radius:var(--arc-r-sm,8px);background:var(--coco-surface,#fff);color:var(--coco-ink,#283B42);font:400 14px/1.5 var(--arc-font,Inter,Arial,sans-serif);box-shadow:none}.ds-field-input:focus-visible{outline:2px solid var(--arc-accent-600,#2F7180);outline-offset:3px;}.ds-field-input[aria-invalid=true]{border-color:var(--arc-danger,#AD403B);background:var(--arc-danger-bg,#FBEEEC)}.ds-field-input[readonly]{background:var(--coco-inset,#EEF3F4)}@media(max-width:760px){.ds-field-input{font-size:16px}}"
    },
    {
      "name": "Onglets de module",
      "kind": "nav",
      "refersTo": "module-tab",
      "description": "Onglets natifs dans le contenu du module, défilants, avec sélection pétrole.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Exemple de sections\"><button class=\"ds-tab\" aria-current=\"page\">Vue d’ensemble</button><button class=\"ds-tab\">Historique</button></nav>",
      "css": ".ds-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 0}.ds-tab{flex:none;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:var(--arc-r-sm,8px);background:transparent;color:var(--coco-ink,#283B42);font:400 13px/1.4 var(--arc-font,Inter,Arial,sans-serif);cursor:pointer}.ds-tab[aria-current=page]{background:var(--arc-accent-100,#E5F0F2);border-color:var(--arc-accent-600,#2F7180);color:var(--arc-accent-700,#245C69);font-weight:500}.ds-tab:hover{background:var(--arc-accent-100,#E5F0F2)}.ds-tab:focus-visible{outline:2px solid var(--arc-accent-600,#2F7180);outline-offset:-3px}.ds-tab:active{background:var(--arc-accent-100,#E5F0F2)}"
    },
    {
      "name": "Statut confirmé",
      "kind": "chip",
      "refersTo": "status-success",
      "description": "Indication lisible ; le texte explicite porte le sens du statut.",
      "html": "<span class=\"ds-status\">Confirmé</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:4px;padding:4px 9px;border:0;border-radius:6px;background:var(--arc-success-bg,#EDF6F0);color:var(--arc-success,#28704E);font:500 12px/1.55 var(--arc-font,Inter,Arial,sans-serif)}"
    },
    {
      "name": "Panneau de travail",
      "kind": "card",
      "refersTo": "panel",
      "description": "Surface blanche opaque et profondeur légère ; une seule ombre par groupe.",
      "html": "<article class=\"ds-panel\"><h3 class=\"ds-panel-title\">Détails</h3><p class=\"ds-panel-text\">Les informations complémentaires restent accessibles dans le dossier.</p></article>",
      "css": ".ds-panel{padding:24px;border:0;border-radius:var(--arc-r-lg,16px);background:var(--coco-surface,#fff);color:var(--coco-ink,#283B42);box-shadow:var(--coco-surface-shadow);font:400 14px/1.55 var(--arc-font,Inter,Arial,sans-serif)}.ds-panel-title{margin:0 0 12px;font-family:var(--arc-font-display,Poppins,Inter,Arial,sans-serif);font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.02em}.ds-panel-text{margin:0;color:var(--coco-muted,#5F7178)}@media(max-width:760px){.ds-panel{padding:16px;border-radius:12px}}"
    },
    {
      "name": "Fiche mobile de liste",
      "kind": "custom",
      "refersTo": "mobile-card",
      "description": "Fiche de consultation à valeurs de 16 px et libellés de colonne visibles.",
      "html": "<article class=\"ds-record\"><h3 class=\"ds-record-title\">Référence</h3><dl class=\"ds-record-fields\"><div><dt>Client</dt><dd>Nom du client</dd></div><div><dt>Statut</dt><dd>À traiter</dd></div></dl><button class=\"ds-record-action\" type=\"button\">Ouvrir</button></article>",
      "css": ".ds-record{padding:16px;border:0;border-radius:12px;background:var(--coco-surface,#fff);box-shadow:var(--coco-surface-shadow);color:var(--coco-ink,#283B42);font:400 16px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-record-title{margin:0 0 12px;font-size:16px;line-height:1.5;font-weight:600}.ds-record-fields{margin:0}.ds-record-fields>div{display:grid;grid-template-columns:108px minmax(0,1fr);gap:10px;padding:6px 0}.ds-record-fields dt{font-size:11px;color:var(--coco-muted,#5F7178)}.ds-record-fields dd{margin:0;overflow-wrap:anywhere}.ds-record-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#E1E8EA);border-radius:var(--arc-r-sm,8px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);margin-top:8px;background:var(--coco-surface,#fff);color:var(--coco-ink,#283B42)}.ds-record-action:hover{background:var(--coco-inset,#EEF3F4);border-color:var(--arc-accent-600,#2F7180)}.ds-record-action:focus-visible{outline:2px solid var(--arc-accent-600,#2F7180);outline-offset:3px;}.ds-record-action:active{background:var(--arc-accent-50,#F1F7F8)}"
    },
    {
      "name": "Historique replié",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Résumé compact dans le flux ; partage la ligne Outils aux largeurs prévues, sans cloner les contrôles.",
      "html": "<details class=\"ds-history\"><summary class=\"ds-history-summary\">Historique du module</summary><div class=\"ds-history-body\">Aucune action enregistrée.</div></details>",
      "css": ".ds-history{border:0;border-radius:var(--arc-r-lg,16px);background:var(--coco-surface,#fff);box-shadow:var(--coco-surface-shadow);color:var(--coco-ink,#283B42);font:400 13px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-history-summary{box-sizing:border-box;min-height:44px;padding:10px 12px;font-weight:500;cursor:pointer}.ds-history-summary:hover{background:var(--coco-inset,#EEF3F4)}.ds-history-summary:focus-visible{outline:2px solid var(--arc-accent-600,#2F7180);outline-offset:3px;}.ds-history-summary:active{background:var(--arc-accent-50,#F1F7F8)}.ds-history[open]>.ds-history-summary{border-bottom:1px solid var(--coco-line,#E1E8EA)}.ds-history-body{padding:12px;color:var(--coco-muted,#5F7178)}"
    },
    {
      "name": "Lien latéral",
      "kind": "nav",
      "refersTo": "sidebar-link",
      "description": "Destination du menu PC ou du tiroir, avec état courant explicite.",
      "html": "<nav class=\"ds-side\" aria-label=\"Exemple de modules\"><a class=\"ds-side-link\" href=\"#dashboard\" aria-current=\"page\">Dashboard</a><a class=\"ds-side-link\" href=\"#documents\">Documents</a></nav>",
      "css": ".ds-side{width:208px;padding:12px;background:var(--coco-surface,#FFFFFF);border-radius:20px}.ds-side-link{display:flex;align-items:center;box-sizing:border-box;min-height:44px;padding:10px 12px;margin-bottom:4px;border-radius:8px;color:var(--coco-ink,#283B42);font:400 13px/1.5 var(--arc-font,Inter,Arial,sans-serif);text-decoration:none}.ds-side-link[aria-current=page]{background:var(--arc-accent-100,#E5F0F2);color:var(--arc-accent-700,#245C69)}.ds-side-link:hover,.ds-side-link:active{background:var(--coco-inset,#EEF3F4)}.ds-side-link:focus-visible{outline:2px solid var(--arc-accent-600,#2F7180);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Coco / GAMA — gestion sereine",
    "overview": "Coco ERP privilégie un travail quotidien calme et lisible : choisir un module, repérer ou rechercher une information, puis agir dans les parcours existants. Une toile neutre, des surfaces blanches, des accents GAMA atténués et une hiérarchie compacte rendent les données utiles visibles plus tôt. Les formulaires séparent clairement libellés, valeurs et groupes de champs sans élargir les listes opérationnelles.\n\nCe contrat décrit l’application interne servie par `src/app/index.html`. Il réconcilie la finition professionnelle du 4 novembre 2026 demandée par le propriétaire avec la structure ERP existante ; les références Geex restent historiques. Les tokens viennent de `src/styles/tokens.css`, appliqués par `workbench.css`, `design.css`, les contrôles partagés et les feuilles différées. Les fonctions, identifiants, droits, langues FR/ES/EN, favoris, historiques et données métier sont conservés. Le site public possède son propre `DESIGN.md` à la racine.",
    "keyCharacteristics": [
      "Toile neutre, surfaces blanches et ombres peu profondes.",
      "Inter pour le travail courant, Poppins pour les titres.",
      "Libellés proches de leur champ et groupes de formulaire espacés.",
      "Orange cuivré pour la commande principale, pétrole pour les liens et sélections.",
      "Navigation et utilitaires compacts, structures métier conservées."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Réserver l’orange d’action à la commande principale ; employer le pétrole pour les liens et les sélections.",
        "section": "colors"
      },
      {
        "name": "The Readability Rule",
        "body": "Conserver les libellés complets, les traductions et le retour à la ligne sans comprimer la cible de commande.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Un groupe de contenu porte une seule ombre ; ses tableaux et sous-panneaux restent plats.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reprendre les tokens et composants communs avant d’ajouter une règle locale.",
      "Do distinguer l’espace d’un formulaire de la densité d’une liste opérationnelle.",
      "Do conserver les pictogrammes Coco, les favoris et une action principale identifiable.",
      "Do laisser accessibles les colonnes, détails et formulaires complets à la demande.",
      "Do respecter les préférences existantes, les langues, les droits et les états réels.",
      "Do vérifier ensemble PC, téléphone, clavier et traductions longues."
    ],
    "donts": [
      "Don't remettre une seconde occurrence du titre de module dans le contenu.",
      "Don't déplacer ni cloner les contrôles métier pour composer une barre utilitaire.",
      "Don't empiler les ombres ni ajouter des halos ou textures décoratifs.",
      "Don't utiliser l’orange brut du logo pour une action à texte blanc.",
      "Don't forcer les lignes éditables ou les fenêtres en fiches sans préserver leurs contrôles.",
      "Don't transformer une valeur inconnue ou un échec de chargement en zéro ou succès.",
      "Don't appliquer ce contrat au site public ni modifier son autorité visuelle racine."
    ]
  }
}
