      "css": ".ds-status{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border:0;border-radius:9px;background:var(--arc-success-bg,#e4f5ec);color:var(--arc-success,#0d7446);font:400 12px/1.45 var(--arc-font,Poppins,Inter,Arial,sans-serif)}"
