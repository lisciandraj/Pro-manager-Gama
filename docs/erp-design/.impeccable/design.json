    },
    {
      "name": "Panneau de travail",
      "kind": "card",
      "refersTo": "panel",
      "description": "Panneau blanc sans ombre : padding20/rayon8 px sur PC, padding16/rayon8 px sur téléphone.",
      "html": "<article class=\"ds-panel\"><h3 class=\"ds-panel-title\">Détails</h3><p class=\"ds-panel-text\">Les informations complémentaires restent accessibles dans le dossier.</p></article>",
      "css": ".ds-panel{padding:20px;border:1px solid var(--coco-line,#F1F0EF);border-radius:var(--arc-r-lg,8px);background:var(--coco-surface,#fff);color:var(--coco-ink,#151515);box-shadow:none;font:400 14px/1.55 var(--arc-font,Inter,Arial,sans-serif)}.ds-panel-title{margin:0 0 12px;font-family:var(--arc-font-display,Inter,Arial,sans-serif);font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.02em}.ds-panel-text{margin:0;color:var(--coco-muted,#6B6A69)}@media(max-width:760px){.ds-panel{padding:16px;border-radius:8px}}"
    },
    {
      "name": "Fiche mobile de liste",
      "kind": "custom",
      "refersTo": "mobile-card",
      "description": "Fiche de consultation à valeurs de 16 px et libellés de colonne visibles.",
      "html": "<article class=\"ds-record\"><h3 class=\"ds-record-title\">Référence</h3><dl class=\"ds-record-fields\"><div><dt>Client</dt><dd>Nom du client</dd></div><div><dt>Statut</dt><dd>À traiter</dd></div></dl><button class=\"ds-record-action\" type=\"button\">Ouvrir</button></article>",
      "css": ".ds-record{padding:16px;border:1px solid var(--coco-line,#F1F0EF);border-radius:8px;background:var(--coco-surface,#fff);box-shadow:none;color:var(--coco-ink,#151515);font:400 16px/1.5 var(--arc-font,Inter,Arial,sans-serif)}.ds-record-title{margin:0 0 12px;font-size:16px;line-height:1.5;font-weight:600}.ds-record-fields{margin:0}.ds-record-fields>div{display:grid;grid-template-columns:108px minmax(0,1fr);gap:10px;padding:6px 0}.ds-record-fields dt{font-size:11px;color:var(--coco-muted,#6B6A69)}.ds-record-fields dd{margin:0;overflow-wrap:anywhere}.ds-record-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;min-height:44px;padding:10px 16px;border:1px solid var(--coco-line,#F1F0EF);border-radius:var(--arc-r-sm,6px);box-shadow:none;cursor:pointer;font:500 14px/1.55 var(--arc-font,Inter,Arial,sans-serif);margin-top:8px;background:var(--coco-surface,#fff);color:var(--coco-ink,#151515)}.ds-record-action:hover{background:var(--coco-inset,#F9F8F8);border-color:var(--arc-accent-600,#B93B00)}.ds-record-action:focus-visible{outline:2px solid var(--arc-accent-600,#B93B00);outline-offset:3px;}.ds-record-action:active{background:var(--arc-accent-50,#FDF7F2)}"
    },
    {
