# Install outside Git as /etc/coco/backup.env, root-owned 0600. Never copy real values here.
COCO_DATABASE_URL=
COCO_SUPABASE_URL=
COCO_SERVICE_KEY=
COCO_AGE_RECIPIENT=
COCO_VAULT_ASSETS_FILE=/etc/coco/vault-assets.json
# Operator attestation, not an automated claim: destination is off the source provider.
COCO_BACKUP_LOCATION_ATTESTED=off-provider
# Optional existing monitoring destination. Only event/count/time are posted; redirects refused.
COCO_ALERT_WEBHOOK_URL=
