# Install outside Git as /etc/coco/backup.env, root-owned 0600. Never copy real values here.
COCO_DATABASE_URL=
COCO_SUPABASE_URL=
COCO_SERVICE_KEY=
COCO_AGE_RECIPIENT=
COCO_VAULT_ASSETS_FILE=/etc/coco/vault-assets.json
# Operator attestation, not an automated claim: destination is off the source provider.
COCO_BACKUP_LOCATION_ATTESTED=off-provider
# Google Drive: private folder « Coco ERP - sécurité ». Paste its verified ID here.
# Not provisioned/activated by this example. No folder ID has been guessed.
COCO_DRIVE_FOLDER_ID=
# Exactly one source: short-lived token env, OR an absolute raw-token file owned
# by coco-backup, mode 0600/0400, no links. Refresh externally before each job.
COCO_DRIVE_ACCESS_TOKEN=
COCO_DRIVE_TOKEN_FILE=/etc/coco/drive-access-token
# Never put an age private identity, OAuth refresh token or service-account JSON
# into this token file or the backup inventory. Only a current access token.
# Optional existing monitoring destination. Only event/count/time are posted; redirects refused.
COCO_ALERT_WEBHOOK_URL=
