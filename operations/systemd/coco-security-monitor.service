[Unit]
Description=Check sanitized security signal freshness and deliver alerts

[Service]
Type=oneshot
User=coco-backup
Group=coco-backup
EnvironmentFile=/etc/coco/backup.env
ExecStart=/usr/bin/python3 /opt/coco/scripts/coco-operations.py signals --file /var/lib/coco-monitor/signals.json --send-alert
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/coco-monitor /etc/coco
TimeoutStartSec=2m
