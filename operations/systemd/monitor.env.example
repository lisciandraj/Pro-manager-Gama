# Copy outside Git to /etc/coco/monitor.env, root-owned0600, loaded by systemd.
# Exactly one env value OR absolute owner-private raw-token file per credential.
# Management credential needs analytics:read only. No database:write permission.
COCO_MONITOR_ACCESS_TOKEN=
COCO_MONITOR_ACCESS_TOKEN_FILE=/etc/coco/monitor-management-token
# The private host supplies its existing Supabase service credential to the
# service-only aggregate RPC. Never use it in a browser, argv, Git or logs.
COCO_MONITOR_SERVICE_KEY=
COCO_MONITOR_SERVICE_KEY_FILE=/etc/coco/monitor-service-key
# Token files belong to coco-backup, 0600/0400, regular, no symlink/hardlink.
# Existing HTTPS alert destination; no personal messaging channel is created.
COCO_ALERT_WEBHOOK_URL=
