# Private gateway only. NEVER add this file's real values to browser code or Git.
SRI_PROVIDER=openapi
SRI_WORKER_SECRET=
SRI_ISSUER_RUC=
SRI_OPENAPI_URL=https://your-private-openapi-service.example
SRI_OPENAPI_EMAIL=
SRI_OPENAPI_PASSWORD=
SRI_OPENAPI_ENVIRONMENT=pruebas
# Legal company setting; deliberately no guessed default (SI or NO).
SRI_OPENAPI_ACCOUNTING=
# Set only after verifying SRI_EMISION_ASYNC=false on the upstream instance.
SRI_OPENAPI_SYNC_CONFIRMED=false
SRI_PRODUCTION_ENABLED=false
# Optional explicit customer delivery; never sent automatically on emission.
SRI_SMTP_HOST=
SRI_SMTP_PORT=465
SRI_SMTP_USER=
SRI_SMTP_PASSWORD=
SRI_SMTP_FROM=
# Separate Supabase Edge secrets:
# SRI_PROVIDER=openapi
# SRI_WORKER_URL=https://your-private-gateway.example
# SRI_WORKER_SECRET=<same high-entropy secret as above>
# SRI_EMISSION_ENABLED=false

# Optional scheduler: public API key + dedicated 256-bit hex capability only.
SRI_SUPABASE_URL=
SRI_SUPABASE_PUBLISHABLE_KEY=
SRI_RECONCILE_TOKEN=
SRI_RECONCILE_INTERVAL=60
# Install SRI_RECONCILE_TOKEN on Edge too; no service_role on this private host.
